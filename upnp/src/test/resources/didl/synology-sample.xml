<DIDL-Lite xmlns="urn:schemas-upnp-org:metadata-1-0/DIDL-Lite/"
           xmlns:dc="http://purl.org/dc/elements/1.1/"
           xmlns:upnp="urn:schemas-upnp-org:metadata-1-0/upnp/"
           xmlns:sec="http://www.sec.co.kr/">
  <container id="movie_all" parentID="movie" childCount="2" restricted="1">
    <dc:title>Movies &amp; Shows</dc:title>
    <upnp:class>object.container.storageFolder</upnp:class>
  </container>
  <item id="movie_all$missing" parentID="movie_all" restricted="1">
    <dc:title>No Media Here</dc:title>
    <upnp:class>object.item.videoItem.movie</upnp:class>
  </item>
  <item id="movie_all$ok" parentID="movie_all" restricted="1">
    <dc:title>With Media &amp; Sound</dc:title>
    <upnp:class>object.item.videoItem.movie</upnp:class>
    <upnp:albumArtURI>http://192.168.1.5:50002/thumb/ok.jpg</upnp:albumArtURI>
    <res protocolInfo="http-get:*:video/x-matroska:*"
         size="333000000" duration="0:00:05.500" resolution="1920x800"
    >http://192.168.1.5:50002/video/ok.mkv</res>
  </item>
</DIDL-Lite>
